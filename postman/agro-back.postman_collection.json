        {
          "name": "Editar usuário (e-mail duplicado, deve falhar)",
          "request": {
            "method": "PUT",
            "url": "{{base_url}}/usuarios/{{usuario_id}}",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Fulano Editado\",\n  \"email\": \"{{usuario_admin_email}}\",\n  \"papel\": \"CONSULTA\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"status 400\", () => pm.response.to.have.status(400));",
